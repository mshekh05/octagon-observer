# Copy to .env and fill in. Anything left blank is skipped with a warning.

# https://the-odds-api.com (free tier: 500 credits/month)
ODDS_API_KEY=
ODDS_API_REGIONS=us
# Hard cap on credits this tool may spend per run of `watch`
ODDS_API_BUDGET=150

# Alerts: ntfy (self-hosted or ntfy.sh) and/or Telegram
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM: none | ollama | claude
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Betting guardrails
BANKROLL=1000
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.03
EDGE_PREFIGHT=0.04
EDGE_LIVE=0.06
# Weight of the stats model vs the market in the blend (0..1)
MODEL_WEIGHT=0.35
# Aggregated handicapper picks (splitpicks.com "Kings Table" for one event); blank skips it
SPLITPICKS_URL=https://splitpicks.com/kings/ufc-333-volkanovski-vs-evloev
# Weight of that consensus against everything else already blended, applied last (0..1)
EXPERT_WEIGHT=0.15

# ---------- App server (Phase 1+) ----------
# Long random string; the phone app asks for it once (Settings tab). Required when exposed to the internet.
APP_TOKEN=
# Public HTTPS address of the app (your tunnel), used for links in alerts
PUBLIC_URL=
# Contact for web push (a mailto: you control), required by push services
VAPID_SUBJECT=mailto:you@example.com
# Which card the worker follows (file in octagon_edge/data/cards/)
ACTIVE_CARD=ufc-333
# Seconds between prediction-market polls / Odds API polls on event day
PM_EVERY=20
ODDS_EVERY=240
# Hour (UTC) the event-day window opens on the card date; 11 suits Abu Dhabi and US cards
EVENT_WINDOW_START_UTC=11
# Set by docker-compose; leave blank to use data/octagon.db (SQLite)
DATABASE_URL=
POSTGRES_PASSWORD=change-me

# ---------- Sentiment sources (optional, free) ----------
# https://www.reddit.com/prefs/apps -> "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Google Cloud console -> YouTube Data API v3 key (10k units/day)
YOUTUBE_API_KEY=
