# Copy to .env and fill in. Anything left blank is skipped with a warning.

# https://the-odds-api.com (free tier: 500 credits/month)
ODDS_API_KEY=
ODDS_API_REGIONS=us
# Hard cap on credits this tool may spend per run of `watch`
ODDS_API_BUDGET=150

# Alerts: ntfy (self-hosted or ntfy.sh) and/or Telegram
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM: none | ollama | claude
LLM_PROVIDER=none
# From Docker, localhost is the container itself: use the Ollama machine's address instead,
# e.g. http://<gpu-host-ip>:11434. Pick a model that machine has pulled (`ollama list`).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
ANTHROPIC_API_KEY=
# Largest probability nudge the LLM may make for news (0..0.03). Off by default: research shows
# short-notice and missed-weight news is already priced in, so a nudge double-counts it.
LLM_MAX_ADJUST=0
CLAUDE_MODEL=claude-opus-5-5

# Betting guardrails
BANKROLL=1000
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.03
EDGE_PREFIGHT=0.04
EDGE_LIVE=0.06
# Weight of the stats model vs the market in the blend (0..1). 0 = the model is shown on the
# Fight page but doesn't move the probability: in both backtests (BestFightOdds lines,
# Kalshi closing prices) blending it in made the market worse. Re-check after model changes.
MODEL_WEIGHT=0
# When the stats model and the market disagree by more than this (0..1), the model is
# usually missing something: a note is shown, and if MODEL_WEIGHT > 0 the fight is marked
# low confidence (higher bar, smaller stake).
MAX_MODEL_GAP=0.25
# Bookmakers under-price youth: shift this many log-odds toward the younger fighter per 5 years
# of age gap (0 turns it off). 0.07 is what the backtest against historical prices fits.
YOUTH_ADJ=0.07
# Aggregated handicapper picks (splitpicks.com "Kings Table" for one event).
# Blank finds the active card's page on https://splitpicks.com/kings automatically; "off" disables it
SPLITPICKS_URL=
# Weight of that consensus against everything else already blended, applied last (0..1).
# 0: `octagon-edge backtest-experts` found it only hurts on top of Kalshi prices (312 fights,
# Apr-Oct 2026). The picks are still shown on the Fight page.
EXPERT_WEIGHT=0

# ---------- App server (Phase 1+) ----------
# Long random string; the phone app asks for it once (Settings tab). Required when exposed to the internet.
APP_TOKEN=
# Public HTTPS address of the app (your tunnel), used for links in alerts
PUBLIC_URL=
# Contact for web push (a mailto: you control), required by push services
VAPID_SUBJECT=mailto:you@example.com
# Which card the worker follows (file in octagon_edge/data/cards/)
ACTIVE_CARD=ufc-333
# Seconds between prediction-market polls / Odds API polls on event day
PM_EVERY=20
ODDS_EVERY=240
# Seconds between Odds API polls in the 7 days before the event (12h before that)
FIGHT_WEEK_ODDS_EVERY=10800
# Hour (UTC) the event-day window opens on the card date; 11 suits Abu Dhabi and US cards
EVENT_WINDOW_START_UTC=11
# Set by docker-compose; leave blank to use data/octagon.db (SQLite)
DATABASE_URL=
POSTGRES_PASSWORD=change-me

# ---------- Sentiment sources (optional, free) ----------
# https://www.reddit.com/prefs/apps -> "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Google Cloud console -> YouTube Data API v3 key (10k units/day)
YOUTUBE_API_KEY=
